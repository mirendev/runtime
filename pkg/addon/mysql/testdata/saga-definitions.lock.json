          "decode-shared-attrs"
        ]
      },
      "update-shared-root-entity": {
        "inputs": [
          "root_altered",
          "rootnewpassword",
          "sharedrootpassword",
          "sharedserverref"
        ],
        "outputs": [
          "rootrecorded"

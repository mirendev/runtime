      "build-dedicated-user-result": {
        "inputs": [
          "dedicateddatabase",
          "dedicatedservicehost",
          "dedicateduser",
          "dedicatedusernewpass"
        ],
        "outputs": [
          "done"
        ],
        "dependencies": [
          "capture-dedicated-conn-info",
          "load-dedicated-rotation-state"
        ]
      },
      "capture-dedicated-conn-info": {
        "inputs": [
          "assocentity"
        ],
        "outputs": [
          "dedicateddatabase",
          "dedicateduser",
          "dedicateduseroldpass"
        ]
      },
      "decode-dedicated-attrs": {
        "inputs": [
          "assocentity"
        ],
        "outputs": [
          "dedicatedserverid"
        ]
      },
      "load-dedicated-rotation-state": {
        "inputs": [
          "dedicatedserverid"
        ],
        "outputs": [
          "dedicatedrootpassword",
          "dedicatedservicehost"
        ],
        "dependencies": [
          "decode-dedicated-attrs"
        ]
      }
    }
  },

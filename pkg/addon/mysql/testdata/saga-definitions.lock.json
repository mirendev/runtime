          "assocentity"
        ],
        "outputs": [
          "shareddbname",
          "sharedserverref",
          "sharedusername"
        ]
      },
      "lookup-shared-server": {
        "inputs": [
          "sharedserverref"
        ],
        "outputs": [
          "sharedassoccount",
          "shareddiskname",
          "sharedpoolref",
          "sharedrootpassword",
          "sharedservicehost",
          "sharedserviceref"
        ],

#!/usr/bin/env bash
# Server lifecycle management for persistent dev environment

set -e

PIDFILE="/tmp/miren-server.pid"
LOGFILE="/tmp/miren-server.log"

# Optional env file and extra flags
ENV_FILE="${DEV_ENV_FILE:-}"
EXTRA_FLAGS="${DEV_SERVER_FLAGS:-}"

# Dev environment defaults:
#   --self-signed-tls: ACME/autocert doesn't work with localhost
#   --dns-names: gives the cluster a workload identity issuer URL. Without a DNS
#     name (or cloud registration) the issuer is never created, and sandboxes get
#     no identity token at all -- so workload identity can't be exercised in dev.
#     The name only has to be stable; nothing resolves it.
DEFAULT_FLAGS="--self-signed-tls --dns-names dev.miren.local"

# How long stop/restart wait for the server to exit on its own before SIGKILL.
# A forced kill skips the server's teardown of the containerd tasks it owns
# (buildkit, etcd, ...), which the next start then has to recover from, so it
# has to be a genuine last resort: the server's own component stops allow up
# to 30s each before escalating, and the old 5s here was tripping well before
# a healthy shutdown had finished (MIR-1856).
STOP_TIMEOUT="${DEV_SERVER_STOP_TIMEOUT:-60}"

# Keep the previous server's log next to the current one. `start` rotates the
# live log aside so `wait-ready` can't match a stale "started" line, and so the
# shutdown that preceded a bad start is still there to read.
PREVLOGFILE="${LOGFILE}.prev"

# wait_for_exit PID SECONDS: poll until PID is gone or SECONDS elapse.
# Returns 0 if the process exited, 1 if it is still running.
wait_for_exit() {
  local pid=$1 seconds=$2 i
  for ((i = 0; i < seconds * 2; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    sleep 0.5
  done
  ! kill -0 "$pid" 2>/dev/null
}

# force_kill PID: SIGKILL a server that ignored its shutdown window, and show
# what it was doing so the escalation leaves evidence behind.
force_kill() {
  local pid=$1
  echo "Warning: server did not exit within ${STOP_TIMEOUT}s, forcing termination (containerd tasks may be orphaned)"
  echo "Last log lines before forced kill:"
  tail -n 20 "$LOGFILE" 2>/dev/null | sed 's/^/  | /'
  kill -9 "$pid" 2>/dev/null || true
  sleep 0.5
}

case "${1:-}" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "Server already running (PID $(cat "$PIDFILE"))"
      exit 0
    fi

    # Source env file if provided
    if [ -n "$ENV_FILE" ]; then
      if [ -f "$ENV_FILE" ]; then
        echo "Sourcing environment from $ENV_FILE"
        set -a
        source "$ENV_FILE"
        set +a
      else
        echo "Warning: ENV_FILE set to '$ENV_FILE' but file not found"
        exit 1
      fi
    fi

    if [ -f "$LOGFILE" ]; then
      mv -f "$LOGFILE" "$PREVLOGFILE"
    fi

    echo "Starting miren server in standalone mode..."
    # Use nohup and disown to fully detach from the shell
    # (Script runs as root for process management privileges)
    nohup ./bin/miren server -vv --mode standalone $DEFAULT_FLAGS $EXTRA_FLAGS >"$LOGFILE" 2>&1 </dev/null &
    pid=$!
    disown
    echo $pid > "$PIDFILE"

    # Wait a moment and verify it started
    sleep 0.5
    if kill -0 "$pid" 2>/dev/null; then
      echo "Server started (PID $pid)"
      echo "Logs: tail -f $LOGFILE"
    else
      echo "Error: Server failed to start. Check $LOGFILE"
      rm -f "$PIDFILE"
      exit 1
    fi
    ;;

  wait-ready)
    # Wait for server to be fully ready (for use in scripts)
    TIMEOUT=${2:-30}
    # Poll every 100ms, print dot every second
    MAX_ITERATIONS=$((TIMEOUT * 10))
    DOT_INTERVAL=10

    echo -n "Waiting for server to be ready"
    for i in $(seq 1 "$MAX_ITERATIONS"); do
      if grep -q "Miren server started" "$LOGFILE" 2>/dev/null; then
        echo " ready!"
        exit 0
      fi
      # Check if server process died
      if [ -f "$PIDFILE" ] && ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo " failed!"
        echo "Error: Server process died. Check $LOGFILE"
        exit 1
      fi
      # Print a dot every second for visual feedback
      if [ $((i % DOT_INTERVAL)) -eq 0 ]; then
        echo -n "."
      fi
      sleep 0.1
    done
    echo " timeout!"
    echo "Error: Server did not become ready within ${TIMEOUT}s. Check $LOGFILE"
    exit 1
    ;;

  stop)
    if [ ! -f "$PIDFILE" ]; then
      echo "Server not running (no PID file)"
      exit 0
    fi

    PID=$(cat "$PIDFILE")
    if kill -0 "$PID" 2>/dev/null; then
      echo "Stopping server (PID $PID)..."
      kill "$PID"
      if ! wait_for_exit "$PID" "$STOP_TIMEOUT"; then
        force_kill "$PID"
      fi
      echo "Server stopped"
    else
      echo "Server not running (stale PID file)"
    fi
    rm -f "$PIDFILE"
    ;;

  restart)
    # Use SIGUSR1 for restart to preserve outboard processes
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      PID=$(cat "$PIDFILE")
      echo "Sending SIGUSR1 to server (PID $PID) for graceful restart..."
      kill -USR1 "$PID"
      if ! wait_for_exit "$PID" 15; then
        echo "Warning: Server did not exit after SIGUSR1, sending SIGTERM..."
        kill "$PID"
        if ! wait_for_exit "$PID" "$STOP_TIMEOUT"; then
          force_kill "$PID"
        fi
      fi
      rm -f "$PIDFILE"
      echo "Server stopped (restart mode)"
    else
      echo "Server not running"
    fi
    sleep 1
    $0 start
    ;;

  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      PID=$(cat "$PIDFILE")
      echo "Server running (PID $PID)"
      echo "Logs: $LOGFILE"
      exit 0
    else
      echo "Server not running"
      exit 1
    fi
    ;;

  logs)
    # -F follows the name, not the inode, so a viewer left open across a
    # restart picks up the new server's log instead of the rotated .prev
    tail -F "$LOGFILE"
    ;;

  prev-logs)
    # The previous server's log, kept by `start` (see PREVLOGFILE)
    cat "$PREVLOGFILE"
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|status|logs|prev-logs|wait-ready [timeout]}"
    exit 1
    ;;
esac
